# Devstack runtime artifacts. Never commit these.
.env
jars/plugin/*
jars/velocity/*
!jars/plugin/.gitkeep
!jars/velocity/.gitkeep
# Synced jars fanned out by run-acceptance.ps1 Sync-ProxyJars into each proxy's
# plugins dir (compose binds proxy-{a,b}/plugins -> /server/plugins).
proxy-a/plugins/*.jar
proxy-b/plugins/*.jar
# Per-backend plugin dirs (compose binds backend-{a,b}/plugins -> /data/plugins).
# Each backend needs its own copy so Paper's .paper-remapped/ cache does not
# race across containers.
backend-a/plugins/*.jar
backend-b/plugins/*.jar
backend-a/plugins/.paper-remapped/
backend-b/plugins/.paper-remapped/
# Paper remap caches for lobby containers (same rationale as backend-*).
lobby-a/plugins/.paper-remapped/
lobby-b/plugins/.paper-remapped/
**/plugins/.paper-remapped/
shared/forwarding.secret
# itzg images write world/cache/log dirs into mounts if you bind them locally.
**/world/
**/world_nether/
**/world_the_end/
**/logs/
**/cache/
# Plugin runtime data dirs (bStats opt-in configs, spark profiler scratch,
# RTP's own runtime data dir under each container). These are per-container
# runtime artifacts, not source.
**/plugins/bStats/
**/plugins/spark/
**/plugins/RTP/
# Proxy 'rtp/' plugin config dir IS source (Velocity lowercases the plugin
# name; on case-insensitive filesystems the rule above matches it too, so
# explicitly unignore it). Backend 'RTP/' stays ignored as runtime data.
!proxy-a/plugins/rtp/
!proxy-b/plugins/rtp/
!proxy-a/plugins/rtp/**
!proxy-b/plugins/rtp/**
# Acceptance / smoke-test evidence logs written by run-acceptance.ps1.
# run-acceptance.ps1 now sorts every run's logs into ./logs/<startup-timestamp>/
# (per-service files keyed by service id) plus an acceptance-evidence.log in
# the same dir. The legacy top-level acceptance-evidence.log path is kept
# ignored for any operator-written one-offs.
acceptance-evidence.log
*.evidence.log
logs/
# Synced jars fanned out into jars/plugin/<pluginName>/ subdirs by sync step.
jars/plugin/*/
jars/velocity/*/
# Optional lobby world (see shared/lobby-world/README.md). Schematics are
# usually license-restricted (BuiltByBit / marketplace ToS) so they must
# never be committed; the derived baked world zip is a build artifact.
shared/lobby-world/*.schem
shared/lobby-world/*.schematic
shared/lobby-world.zip
# Scratch dir used by scripts/bake-lobby-world.ps1 while pasting the schematic.
shared/lobby-world.bake/

# Backend / lobby rtp-config: only network.yml is genuinely per-instance
# (serverId, proxyId, transport host/port, lobby designation). Everything
# else (config.yml, messages.yml, economy.yml, integrations.yml,
# language.yml, logging.yml, metrics.yml, performance.yml, safety.yml,
# plus the lang/, worlds/, regions/, effects/ baseline trees, and the
# auto-extracted docs/ tree) is shipped inside the plugin jar and
# self-populates on first boot. Committing the extracted copies turns
# them into stale shadows that block the plugin's own version-bump-driven
# self-population (see .junie/AGENTS.md "Locale Config TSV Pipeline" and
# the Slice-5 messages.yml self-population regression). Runtime database
# files under rtp-config/database/ are also per-container state and
# never source.
backend-a/rtp-config/**
backend-b/rtp-config/**
lobby-a/rtp-config/**
lobby-b/rtp-config/**
!backend-a/rtp-config/
!backend-b/rtp-config/
!lobby-a/rtp-config/
!lobby-b/rtp-config/
!backend-a/rtp-config/network.yml
!backend-b/rtp-config/network.yml
!lobby-a/rtp-config/network.yml
!lobby-b/rtp-config/network.yml
# Lite (plugin-message transport) seed variants, selected by run-acceptance.ps1
# -Lite via docker-compose.lite.yml. Per-instance source like network.yml.
!backend-a/rtp-config/network-lite.yml
!backend-b/rtp-config/network-lite.yml
!lobby-a/rtp-config/network-lite.yml
!lobby-b/rtp-config/network-lite.yml
