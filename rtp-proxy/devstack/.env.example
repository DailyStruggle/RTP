# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# RTP_NET_SECRET: shared HMAC secret distributed to every proxy and backend.
# Required (REQ-RTP-PROXY-007). Must be at least 32 bytes when decoded.
#
# Generate on Windows PowerShell:
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
#
# Generate on Linux:
#   head -c 32 /dev/urandom | base64
RTP_NET_SECRET=replace-me-with-32-byte-base64

# OPS (optional): comma-separated player names or UUIDs to seed into each backend's
# ops.json on container start (itzg/minecraft-server reads this). Lets you test
# op-gated commands like /rtp test on first join without console access. Leave
# unset for no ops. Devstack convenience only; do NOT use this pattern in prod.
#
# The compose file sets OVERRIDE_OPS=TRUE on both backends, so changing this
# value and restarting the stack will re-seed ops.json even on a non-fresh
# world. (Without OVERRIDE_OPS, itzg only writes ops.json once per world.)
#
# Example (uncomment and replace with your in-game name):
#OPS=YourIGN
#OPS=YourIGN,FriendIGN
