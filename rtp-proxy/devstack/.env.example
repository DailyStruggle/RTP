# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# RTP_NET_SECRET: shared HMAC secret distributed to every proxy and backend.
# Required (REQ-RTP-PROXY-007). Must be at least 32 bytes when decoded.
#
# Generate on Windows PowerShell:
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
#
# Generate on Linux:
#   head -c 32 /dev/urandom | base64
RTP_NET_SECRET=replace-me-with-32-byte-base64
