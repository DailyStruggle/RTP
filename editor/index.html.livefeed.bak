    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Duration (seconds) a player remains in combat after a PvP hit (built-in tracker).<\/p>",
    "meta": "Type: Integer | Default: `15` | Docs: SAFETY.md",
    "defaultVal": "`15`",
    "defaultSnippet": "pvpCombatTagSeconds: `15`"
  },
  "pvponcombat": {
    "title": "pvpOnCombat",
    "desc": "Action taken when a player in combat attempts `/rtp`. Options: `ALLOW`, `DENY`, `DELAY`, `CANCEL`.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Action taken when a player in combat attempts <code style=\\\"color:var(--yellow);\\\"><b>/rtp<\/b><\/code>. Options: <code style=\\\"color:var(--yellow);\\\"><b>ALLOW<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>DENY<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>DELAY<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>CANCEL<\/b><\/code>.<\/p>",
    "meta": "Type: Enum | Default: `\"DENY\"` | Docs: SAFETY.md",
    "defaultVal": "`\"DENY\"`",
    "defaultSnippet": "pvpOnCombat: `\"DENY\"`"
  },
  "pvpsource": {
    "title": "pvpSource",
    "desc": "Source for combat state. Options: `AUTO` (external plugin if present, else native), `NATIVE` (built-in tracker only), `EXTERNAL` (plugin hook only).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Source for combat state. Options: <code style=\\\"color:var(--yellow);\\\"><b>AUTO<\/b><\/code> (external plugin if present, else native), <code style=\\\"color:var(--yellow);\\\"><b>NATIVE<\/b><\/code> (built-in tracker only), <code style=\\\"color:var(--yellow);\\\"><b>EXTERNAL<\/b><\/code> (plugin hook only).<\/p>",
    "meta": "Type: Enum | Default: `\"AUTO\"` | Docs: SAFETY.md",
    "defaultVal": "`\"AUTO\"`",
    "defaultSnippet": "pvpSource: `\"AUTO\"`"
  },
  "pvptagvictim": {
    "title": "pvpTagVictim",
