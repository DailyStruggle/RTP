    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">If <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, the radii grow automatically as locations are consumed.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: CONFIGURATION.md",
