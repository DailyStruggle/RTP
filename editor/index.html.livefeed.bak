  "weight": {
    "title": "weight",
    "desc": "Archimedean spiral distribution bias across valid band (>1.0 pulls center, <1.0 pushes edge, 1.0 uniform).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Archimedean spiral distribution bias across valid band (>1.0 pulls center, <1.0 pushes edge, 1.0 uniform).<\/p>",
    "meta": "Type: Double | Range: > 0.0 | Default: 1.0 | Docs: REGIONS.md",
    "defaultVal": "1.0",
    "defaultSnippet": "weight: 1.0"
  },
