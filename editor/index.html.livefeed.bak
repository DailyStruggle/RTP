    "title": "mean",
    "desc": "Mean of the normal distribution (0.0 = centre, 1.0 = edge).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Mean of the normal distribution (0.0 = centre, 1.0 = edge).<\/p>",
    "meta": "Type: Double | Docs: CONFIGURATION.md",
