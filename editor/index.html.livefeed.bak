    "meta": "Type: Double | Docs: CONFIGURATION.md",
    "defaultVal": "",
    "defaultSnippet": ""
  },
  "shapewidth": {
    "title": "shape.width",
    "desc": "Full width of the rectangle (total X-axis extent, centred on the region; supports spatial suffixes).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Full width of the rectangle (total X-axis extent, centred on the region; supports spatial suffixes).<\/p>",
    "meta": "Type: Integer / Distance | Docs: CONFIGURATION.md",
    "defaultVal": "",
    "defaultSnippet": ""
  },
  "width": {
    "title": "width",
    "desc": "Full width of the rectangle (total X-axis extent, centred on the region; supports spatial suffixes).",
