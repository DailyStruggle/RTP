function getMatchingSynonyms(tokens) {
  const matched = new Set();
  if (!tokens || tokens.length === 0) return matched;

  for (const rawTok of tokens) {
    const tok = (rawTok || '').trim().toLowerCase();
    if (!tok) continue;

    for (const [conceptKey, synList] of Object.entries(CONFIG_SYNONYMS)) {
      const ck = conceptKey.toLowerCase();
      // 1. Direct or substring match on concept key (e.g. "rad" in "radius")
      if (ck === tok || ck.includes(tok) || tok.includes(ck)) {
        matched.add(ck);
        synList.forEach(s => matched.add(s.toLowerCase()));
      }

      // 2. Fuzzy match on concept key (e.g. typos like "raduis" -> "radius")
      if (tok.length >= 3) {
        const maxDist = tok.length >= 5 ? 2 : 1;
        if (computeLevenshtein(tok, ck) <= maxDist) {
          matched.add(ck);
          synList.forEach(s => matched.add(s.toLowerCase()));
        }
      }

      // 3. Match against items in the synonym list
      for (const syn of synList) {
        const sl = syn.toLowerCase();
        if (sl === tok || sl.includes(tok) || tok.includes(sl)) {
          matched.add(sl);
          matched.add(ck);
          synList.forEach(s => matched.add(s.toLowerCase()));
          break;
        }
        if (tok.length >= 3) {
          const maxDist = tok.length >= 5 ? 2 : 1;
          if (computeLevenshtein(tok, sl) <= maxDist) {
            matched.add(sl);
            matched.add(ck);
            synList.forEach(s => matched.add(s.toLowerCase()));
            break;
          }
        }
      }
    }
  }
  return matched;
}

function computeLevenshtein(a, b) {
  if (!a || !b) return (a || b) ? (a || b).length : 0;
  const m = a.length;
  const n = b.length;
  const dp = [];
  for (let i = 0; i <= m; i++) {
    dp[i] = [i];
  }
  for (let j = 0; j <= n; j++) {
    dp[0][j] = j;
  }
  for (let i = 1; i <= m; i++) {
    for (let j = 1; j <= n; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      dp[i][j] = Math.min(
        dp[i - 1][j] + 1,
        dp[i][j - 1] + 1,
        dp[i - 1][j - 1] + cost
      );
    }
  }
  return dp[m][n];
}

let activeSearchResults = [];
let selectedSearchHitIndex = 0;
let searchDebounceTimer = null;
const remoteSynonymCache = new Map();

function buildConfigSearchIndex() {
  const index = [];
  for (const [filename, content] of Object.entries(configs)) {
    if (!content) continue;
    const lines = content.split('\n');
    for (let lineIdx = 0; lineIdx < lines.length; lineIdx++) {
      const rawLine = lines[lineIdx];
      const trimmed = rawLine.trim();
      if (!trimmed || trimmed.startsWith('#')) continue;
      
      const colonIdx = trimmed.indexOf(':');
      if (colonIdx > 0) {
        const key = trimmed.substring(0, colonIdx).trim();
        const val = trimmed.substring(colonIdx + 1).trim();
        if (/^[a-zA-Z0-9_.-]+$/.test(key)) {
          const lk = key.toLowerCase().replace(/[^a-z0-9]/g, '');
          const doc = docTrackerDb[lk];
          index.push({
            file: filename,
            key: key,
            normKey: key.toLowerCase(),
            lineNum: lineIdx + 1,
            val: val,
            snippet: rawLine,
            docTitle: doc ? doc.title : '',
            docDesc: doc ? (doc.desc || '') : '',
            docMeta: doc ? (doc.meta || '') : ''
          });
        }
      }
    }
  }
  return index;
}

function executeConfigSearch(rawQuery, remoteExpandedWords = []) {
  const query = (rawQuery || '').trim().toLowerCase();
  if (!query && remoteExpandedWords.length === 0) return [];

  const index = buildConfigSearchIndex();
  const hits = [];

  // Gather synonyms and similar phrases for query tokens using getMatchingSynonyms
  const queryTokens = query.split(/\s+/).filter(Boolean);
  const matchedSynonyms = getMatchingSynonyms(queryTokens);
  
  remoteExpandedWords.forEach(w => {
    matchedSynonyms.add(w.toLowerCase());
    if (CONFIG_SYNONYMS[w.toLowerCase()]) {
      CONFIG_SYNONYMS[w.toLowerCase()].forEach(s => matchedSynonyms.add(s.toLowerCase()));
    }
    const extra = getMatchingSynonyms([w]);
    extra.forEach(s => matchedSynonyms.add(s));
  });

  for (const item of index) {
    let score = 0;
    const reasons = [];
    const k = item.normKey;
    const f = item.file.toLowerCase();
    const v = (item.val || '').toLowerCase();
    const d = (item.docDesc || '').toLowerCase();
    const dt = (item.docTitle || '').toLowerCase();

    // 1. Exact Key Match
    if (query && k === query) {
      score += 120;
      reasons.push({ type: 'reason', text: 'Exact Key' });
    } else if (query && (k.startsWith(query) || (k.includes(query) && query.length >= 3))) {
      score += 80;
      reasons.push({ type: 'reason', text: 'Key Match' });
    }

    // 2. File Name Match
    if (query && f.includes(query)) {
      score += 40;
      reasons.push({ type: 'file', text: 'File Match' });
    }

    // 3. Thesaurus / Similar Phrase Match
    for (const syn of matchedSynonyms) {
      if (k === syn || k.includes(syn) || syn.includes(k)) {
        score += 65;
        reasons.push({ type: 'synonym', text: `Similar: ${syn}` });
        break;
      }
    }

    // 4. Fuzzy Levenshtein Distance (Typo Tolerance & Fuzzy Key Matching)
    if (query && query.length >= 3) {
      const dist = computeLevenshtein(query, k);
      const maxAllowed = query.length >= 5 ? 2 : 1;
      if (dist <= maxAllowed && !reasons.some(r => r.type === 'reason' || r.type === 'synonym')) {
        score += Math.max(45 - dist * 10, 20);
        reasons.push({ type: 'fuzzy', text: `Fuzzy ~${k}` });
      }
    }

    // 5. Value Match
    if (query && v && v.includes(query)) {
      score += 30;
      reasons.push({ type: 'reason', text: 'Value Match' });
    }

    // 6. Documentation Prose / Description Match (docTrackerDb)
    if (query && (d.includes(query) || dt.includes(query))) {
      score += 25;
      reasons.push({ type: 'doc', text: 'Doc Match' });
    }
    // Also check if expanded synonyms match doc descriptions
    for (const syn of matchedSynonyms) {
      if (d.includes(syn) || dt.includes(syn)) {
        score += 20;
        if (!reasons.some(r => r.type === 'doc')) {
          reasons.push({ type: 'doc', text: `Doc Match (${syn})` });
        }
        break;
      }
    }

    if (score > 0) {
      hits.push({
        ...item,
        score,
        reasons: deduplicateReasons(reasons)
      });
    }
  }

  // Deduplicate and rank descending by score
  const uniqueHits = new Map();
  for (const h of hits) {
    const key = `${h.file}:${h.key}`;
    if (!uniqueHits.has(key) || uniqueHits.get(key).score < h.score) {
      uniqueHits.set(key, h);
    }
  }

  return Array.from(uniqueHits.values()).sort((a, b) => b.score - a.score).slice(0, 30);
}

function deduplicateReasons(reasons) {
  const seen = new Set();
  const out = [];
  for (const r of reasons) {
    const id = `${r.type}:${r.text}`;
    if (!seen.has(id)) {
      seen.add(id);
      out.push(r);
    }
  }
  return out;
}

function openSearchModal() {
  const overlay = document.getElementById('search-modal-overlay');
  const input = document.getElementById('palette-query-input');
  if (overlay) {
    overlay.style.display = 'flex';
    if (input) {
      input.focus();
      input.select();
      handleSearchInput(input.value);
    }
  }
}

function closeSearchModal() {
  const overlay = document.getElementById('search-modal-overlay');
  if (overlay) overlay.style.display = 'none';
}

function handleSearchInput(rawVal) {
  const query = (rawVal || '').trim();
  const resultsContainer = document.getElementById('palette-results-list');
  if (!resultsContainer) return;

  if (!query) {
    resultsContainer.innerHTML = `
      <div style="padding:24px 16px; text-align:center; color:var(--subtext); font-size:0.85rem;">
        Type any keyword, concept (e.g. <i>"money"</i>, <i>"cost"</i>, <i>"dinero"</i>), or configuration key name.
      </div>`;
    activeSearchResults = [];
    return;
  }

  // Immediate local search
  activeSearchResults = executeConfigSearch(query);
  renderSearchResults(activeSearchResults, query);

  // Progressive background remote expansion (online mode)
  triggerRemoteSynonymExpansion(query);
}

function renderSearchResults(hits, query) {
  const resultsContainer = document.getElementById('palette-results-list');
  if (!resultsContainer) return;

  if (hits.length === 0) {
    resultsContainer.innerHTML = `
      <div style="padding:28px 16px; text-align:center; color:var(--subtext); font-size:0.85rem;">
        No configuration keys or documentation matches found for "<b style="color:var(--text);">${escapeHtml(query)}</b>".
      </div>`;
    return;
  }

  selectedSearchHitIndex = 0;
  resultsContainer.innerHTML = hits.map((hit, idx) => {
    const badgesHtml = hit.reasons.map(r => {
      const cls = r.type === 'synonym' ? 'hit-badge-synonym' : (r.type === 'fuzzy' ? 'hit-badge-fuzzy' : (r.type === 'doc' ? 'hit-badge-doc' : (r.type === 'file' ? 'hit-badge-file' : 'hit-badge-reason')));
      return `<span class="hit-badge ${cls}">${escapeHtml(r.text)}</span>`;
    }).join('');

    const descText = hit.docDesc ? hit.docDesc.replace(/\n+/g, ' ') : (hit.docMeta || 'Engine configuration parameter.');

    return `
      <div class="search-hit-item ${idx === 0 ? 'active' : ''}" data-index="${idx}" onclick="selectSearchHit(${idx})">
        <div class="search-hit-header">
          <div class="search-hit-title">
            <span>⚙️ <b>${escapeHtml(hit.key)}</b></span>
            <span class="hit-badge hit-badge-file">📄 ${escapeHtml(hit.file)}:${hit.lineNum}</span>
          </div>
          <div class="search-hit-badges">${badgesHtml}</div>
        </div>
        <div class="search-hit-desc">${escapeHtml(descText)}</div>
        <div class="search-hit-snippet">${escapeHtml(hit.snippet)}</div>
      </div>`;
  }).join('');
}

function selectSearchHit(index) {
  const hit = activeSearchResults[index];
  if (!hit) return;

  closeSearchModal();
  switchPanel('panel-configs', document.querySelectorAll('.nav-tab')[2]);
  selectConfig(hit.file);

  // Scroll editor to line and highlight
  setTimeout(() => {
    if (cfgEditor) {
      const lines = cfgEditor.value.split('\n');
      let charPos = 0;
      for (let i = 0; i < Math.min(hit.lineNum - 1, lines.length); i++) {
        charPos += lines[i].length + 1;
      }
      const lineLen = (lines[hit.lineNum - 1] || '').length;
      cfgEditor.focus();
      cfgEditor.setSelectionRange(charPos, charPos + lineLen);

      // Auto-center editor scroll position
      const lineHeight = 19;
      cfgEditor.scrollTop = Math.max(0, (hit.lineNum - 5) * lineHeight);
      trackCurrentConfigLine();
    }
  }, 80);
}

async function triggerRemoteSynonymExpansion(query) {
  if (!navigator.onLine || query.length < 3) return;
  const qClean = query.toLowerCase().trim();
  if (remoteSynonymCache.has(qClean)) {
    const cachedWords = remoteSynonymCache.get(qClean);
    if (cachedWords && cachedWords.length > 0) {
      activeSearchResults = executeConfigSearch(query, cachedWords);
      renderSearchResults(activeSearchResults, query);
    }
    return;
  }

  if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
  const spinner = document.getElementById('search-status-spinner');

  searchDebounceTimer = setTimeout(async () => {
    if (spinner) spinner.style.display = 'inline';
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 1200);

      const url = `https://api.datamuse.com/words?ml=${encodeURIComponent(qClean)}&max=8`;
      const res = await fetch(url, { signal: controller.signal });
      clearTimeout(timeoutId);

      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      // Strict validation & code/database/XSS injection filtering on remote response
      const safeSynonyms = [];
      if (Array.isArray(data)) {
        for (const item of data) {
          if (!item || typeof item.word !== 'string') continue;
          const w = item.word.trim().toLowerCase();
          // Strict token whitelisting: only lowercase letters and single hyphens, 2-24 chars
          // Rejects any quotes, semicolons, brackets, backticks, SQL/script keywords
          if (/^[a-z][a-z\-]{1,23}$/.test(w)) {
            safeSynonyms.push(w);
          }
        }
      }

      remoteSynonymCache.set(qClean, safeSynonyms);
      if (safeSynonyms.length > 0) {
        activeSearchResults = executeConfigSearch(query, safeSynonyms);
        renderSearchResults(activeSearchResults, query);
      }
    } catch (e) {
      // Fail-soft: silent catch without interrupting local results
    } finally {
      if (spinner) spinner.style.display = 'none';
    }
  }, 250);
}

// Global Keyboard Navigation (Ctrl+K, Up/Down, Enter, Esc)
window.addEventListener('keydown', (e) => {
  const overlay = document.getElementById('search-modal-overlay');
  const isSearchOpen = overlay && overlay.style.display === 'flex';

  if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
    e.preventDefault();
    if (isSearchOpen) closeSearchModal();
    else openSearchModal();
    return;
  }

  if (!isSearchOpen) return;

  if (e.key === 'Escape') {
    e.preventDefault();
    closeSearchModal();
  } else if (e.key === 'ArrowDown') {
    e.preventDefault();
    if (activeSearchResults.length > 0) {
      selectedSearchHitIndex = (selectedSearchHitIndex + 1) % activeSearchResults.length;
      updateHitSelectionUI();
    }
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    if (activeSearchResults.length > 0) {
      selectedSearchHitIndex = (selectedSearchHitIndex - 1 + activeSearchResults.length) % activeSearchResults.length;
      updateHitSelectionUI();
    }
  } else if (e.key === 'Enter') {
    e.preventDefault();
    if (activeSearchResults.length > 0) {
      selectSearchHit(selectedSearchHitIndex);
    }
  }
});

function updateHitSelectionUI() {
  const items = document.querySelectorAll('.search-hit-item');
  items.forEach((item, idx) => {
    const isAct = idx === selectedSearchHitIndex;
    item.classList.toggle('active', isAct);
    if (isAct) {
      item.scrollIntoView({ block: 'nearest' });
    }
  });
}

populateConfigSidebar();
selectConfig(currentConfigFile);
populateDocSidebar();
selectDoc(currentDocFile);
syncRegionProfiles();
changeRegionProfile('default');
updateDiagnosticsUI(currentMetrics);
setTimeout(resizeCanvas, 60);
initWebSocket();

// Server biome layers carry raw sample counts; the chip renderer expects 0..1 shares.
function normalizeBiomeShares(biomes) {
  if (!biomes || typeof biomes !== 'object') return biomes;
  const values = Object.values(biomes).filter(v => typeof v === 'number');
  const total = values.reduce((a, b) => a + b, 0);
  if (total <= 0 || values.every(v => v <= 1)) return biomes;
  const out = {};
  for (const [k, v] of Object.entries(biomes)) out[k] = (typeof v === 'number') ? v / total : v;
  return out;
}

// ADR-104: Single ingest path for byte-store sessions and embedded local exports.
// Order matters: YAML-derived geometry first (syncRegionProfiles), then server
// visual layers (hazards, walk path, pregen land, biomes) merged on top.
function ingestSessionPayload(payload) {
  if (!payload || typeof payload !== 'object') return;

  if (payload.files && typeof payload.files === 'object') {
    Object.assign(configs, payload.files);
    Object.assign(defaultConfigs, payload.files);
  }

  if (payload.docs && typeof payload.docs === 'object' && Object.keys(payload.docs).length > 0) {
    Object.assign(docs, payload.docs);
    populateDocSidebar();
    selectDoc(docs[currentDocFile] !== undefined ? currentDocFile : Object.keys(docs).sort()[0]);
  }

  if (payload.telemetry && typeof payload.telemetry === 'object') {
    Object.assign(currentMetrics, payload.telemetry);
  } else {
    currentMetrics.players = 0;
  }
  updateDiagnosticsUI(currentMetrics);

  syncRegionProfiles();
  if (payload.regionModels && typeof payload.regionModels === 'object') {
    for (const [rName, rData] of Object.entries(payload.regionModels)) {
      if (!rData || typeof rData !== 'object') continue;
      if (!regionProfiles[rName]) {
        regionProfiles[rName] = Object.assign({}, regionProfiles.default, { name: rName, vertices: [] });
      }
      const layers = Object.assign({}, rData);
      delete layers.region;
      if (layers.biomes) layers.biomes = normalizeBiomeShares(layers.biomes);
      Object.assign(regionProfiles[rName], layers);
    }
    syncRegionProfiles();
  }

  populateConfigSidebar();
  const target = (regionState && regionProfiles[regionState.name]) ? regionState.name : 'default';
  changeRegionProfile(target);
  selectConfig(configs[currentConfigFile] !== undefined ? currentConfigFile : (Object.keys(configs)[0] || 'config.yml'));
  updateStagingDiff();
}

// ADR-104: `/rtp editor local` embeds the live payload as inert JSON so the
// workspace opens fully populated from file:// with no network access.
(function loadEmbeddedPayload() {
  const el = document.getElementById('rtp-embedded-payload');
  if (!el) return;
  const raw = (el.textContent || '').trim();
  if (!raw) return;
  try {
    ingestSessionPayload(JSON.parse(raw));
    const badge = document.getElementById('conn-badge');
    if (badge && !window.location.host) {
      badge.textContent = '● LOCAL EXPORT';
      badge.style.color = 'var(--green)';
      badge.style.borderColor = 'rgba(166, 227, 161, 0.4)';
    }
  } catch (err) {
    console.warn('[RTP Web Editor] Embedded payload could not be parsed:', err);
  }
})();

// ADR-104: Auto-detect session token in URL (?token=XYZ or #XYZ) and fetch live payload
(async function autoLoadSessionFromUrl() {
  const params = new URLSearchParams(window.location.search);
  let token = params.get('token');
  if (!token && window.location.hash) {
    const h = window.location.hash.replace(/^#/, '').trim();
    if (h && !h.includes('/')) token = h;
  }
  const bytebinParam = params.get('bytebin') || 'https://bytebin.lucko.me';
  if (!token) return;

  currentSessionToken = token;
  const tokenLabel = document.getElementById('token-label');
  if (tokenLabel) tokenLabel.textContent = token;
  const applyCmd = document.getElementById('apply-cmd');
  if (applyCmd) applyCmd.textContent = `/rtp editor apply token=${token}`;

  const hudMsg = document.getElementById('hud-region');
  if (hudMsg) hudMsg.textContent = `Loading ${token}...`;

  try {
    const res = await fetch(`${bytebinParam.replace(/\/+$/, '')}/${token}`, {
      headers: { 'Accept': 'application/json' }
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const payload = await res.json();

    ingestSessionPayload(payload);

    const badge = document.getElementById('conn-badge');
    if (badge) {
      badge.textContent = `● BYTE-STORE (${token.substring(0, 8)})`;
      badge.style.color = 'var(--green)';
      badge.style.borderColor = 'rgba(166, 227, 161, 0.4)';
    }
    if (hudMsg) hudMsg.textContent = regionState.name || 'default';
  } catch (err) {
    console.warn('[RTP Web Editor] Failed to fetch session payload from byte-store:', err);
    const badge = document.getElementById('conn-badge');
    if (badge) {
      badge.textContent = '● FETCH ERROR';
      badge.style.color = 'var(--red)';
    }
    // Reset mock players count anyway
    currentMetrics.players = 0;
    updateDiagnosticsUI(currentMetrics);
  }
})();
</script>
</body>
</html>
