  "vertrequireskylight": {
    "title": "vert.requireSkyLight",
    "desc": "If `true`, only accept locations with direct sky access (above-ground only).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">If <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, only accept locations with direct sky access (above-ground only).<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: CONFIGURATION.md",
    "defaultVal": "`false`",
    "defaultSnippet": "requireSkyLight: `false`"
  },
  "requireskylight": {
    "title": "requireSkyLight",
    "desc": "If `true`, only accept locations with direct sky access (above-ground only).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">If <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, only accept locations with direct sky access (above-ground only).<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: CONFIGURATION.md",
    "defaultVal": "`false`",
    "defaultSnippet": "requireSkyLight: `false`"
  },
  "vertstep": {
    "title": "vert.step",
    "desc": "Number of blocks to skip per vertical search iteration. Larger = faster but coarser scan.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Number of blocks to skip per vertical search iteration. Larger = faster but coarser scan.<\/p>",
    "meta": "Type: Integer | Default: `16` | Docs: CONFIGURATION.md",
    "defaultVal": "`16`",
    "defaultSnippet": "step: `16`"
  },
  "step": {
    "title": "step",
    "desc": "Number of blocks to skip per vertical search iteration. Larger = faster but coarser scan.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Number of blocks to skip per vertical search iteration. Larger = faster but coarser scan.<\/p>",
    "meta": "Type: Integer | Default: `16` | Docs: CONFIGURATION.md",
    "defaultVal": "`16`",
    "defaultSnippet": "step: `16`"
  },
  "vertdirection": {
    "title": "vert.direction",
    "desc": "Search direction: `0` = bottom-up (scan from `minY` to `maxY`), `1` = top-down (scan from `maxY` to `minY`), `2` = middle-out (default), `3` = edges-in, any other integer = randomized order.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Search direction: <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> = bottom-up (scan from <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>), <code style=\\\"color:var(--yellow);\\\"><b>1<\/b><\/code> = top-down (scan from <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code>), <code style=\\\"color:var(--yellow);\\\"><b>2<\/b><\/code> = middle-out (default), <code style=\\\"color:var(--yellow);\\\"><b>3<\/b><\/code> = edges-in, any other integer = randomized order.<\/p>",
    "meta": "Type: Integer | Default: `2` | Docs: CONFIGURATION.md",
    "defaultVal": "`2`",
    "defaultSnippet": "direction: `2`"
  },
  "direction": {
    "title": "direction",
    "desc": "Search direction: `0` = bottom-up (scan from `minY` to `maxY`), `1` = top-down (scan from `maxY` to `minY`), `2` = middle-out (default), `3` = edges-in, any other integer = randomized order.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Search direction: <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> = bottom-up (scan from <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>), <code style=\\\"color:var(--yellow);\\\"><b>1<\/b><\/code> = top-down (scan from <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code>), <code style=\\\"color:var(--yellow);\\\"><b>2<\/b><\/code> = middle-out (default), <code style=\\\"color:var(--yellow);\\\"><b>3<\/b><\/code> = edges-in, any other integer = randomized order.<\/p>",
    "meta": "Type: Integer | Default: `2` | Docs: CONFIGURATION.md",
    "defaultVal": "`2`",
    "defaultSnippet": "direction: `2`"
  },
  "verty": {
    "title": "vert.y",
    "desc": "Exact Y level for mid-air placement. No terrain scan runs, so `minY`, `maxY`, `direction`, and `requireSkyLight` are ignored. Intended for skyblock-style worlds; pair it with a platform builder or the player falls through air. See [REGIONS.md](REGIONS.md).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Exact Y level for mid-air placement. No terrain scan runs, so <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>direction<\/b><\/code>, and <code style=\\\"color:var(--yellow);\\\"><b>requireSkyLight<\/b><\/code> are ignored. Intended for skyblock-style worlds; pair it with a platform builder or the player falls through air. See <a href=\\\"REGIONS.md\\\" target=\\\"_blank\\\" style=\\\"color:var(--accent);\\\">REGIONS.md<\/a>.<\/p>",
    "meta": "Type: Integer | Default: `64` | Docs: CONFIGURATION.md",
    "defaultVal": "`64`",
    "defaultSnippet": "y: `64`"
  },
  "y": {
    "title": "y",
    "desc": "Exact Y level for mid-air placement. No terrain scan runs, so `minY`, `maxY`, `direction`, and `requireSkyLight` are ignored. Intended for skyblock-style worlds; pair it with a platform builder or the player falls through air. See [REGIONS.md](REGIONS.md).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Exact Y level for mid-air placement. No terrain scan runs, so <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>direction<\/b><\/code>, and <code style=\\\"color:var(--yellow);\\\"><b>requireSkyLight<\/b><\/code> are ignored. Intended for skyblock-style worlds; pair it with a platform builder or the player falls through air. See <a href=\\\"REGIONS.md\\\" target=\\\"_blank\\\" style=\\\"color:var(--accent);\\\">REGIONS.md<\/a>.<\/p>",
    "meta": "Type: Integer | Default: `64` | Docs: CONFIGURATION.md",
    "defaultVal": "`64`",
    "defaultSnippet": "y: `64`"
  },
  "vertregion": {
    "title": "vert.region",
    "desc": "Default region used when a player runs `/rtp` in this world.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Default region used when a player runs <code style=\\\"color:var(--yellow);\\\"><b>/rtp<\/b><\/code> in this world.<\/p>",
    "meta": "Type: String | Default: `\"default\"` | Docs: CONFIGURATION.md",
    "defaultVal": "`\"default\"`",
    "defaultSnippet": "region: `\"default\"`"
  },
  "region": {
    "title": "region",
    "desc": "The default region used when a player runs `/rtp` while in this world.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">The default region used when a player runs <code style=\\\"color:var(--yellow);\\\"><b>/rtp<\/b><\/code> while in this world.<\/p>",
    "meta": "Type: String | Default: `\"default\"` | Docs: WORLDS.md",
    "defaultVal": "`\"default\"`",
    "defaultSnippet": "region: `\"default\"`"
  },
  "vertrequirepermission": {
    "title": "vert.requirePermission",
    "desc": "If `true`, players need `rtp.worlds.<name>` to RTP in this world.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">If <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, players need <code style=\\\"color:var(--yellow);\\\"><b>rtp.worlds.<name><\/b><\/code> to RTP in this world.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: CONFIGURATION.md",
    "defaultVal": "`false`",
    "defaultSnippet": "requirePermission: `false`"
  },
  "vertoverride": {
    "title": "vert.override",
    "desc": "World to redirect to if a player lacks permission.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">World to redirect to if a player lacks permission.<\/p>",
    "meta": "Type: String | Default: `\"[0]\"` | Docs: CONFIGURATION.md",
    "defaultVal": "`\"[0]\"`",
    "defaultSnippet": "override: `\"[0]\"`"
  },
  "vertversion": {
    "title": "vert.version",
    "desc": "Internal version \u2014 **do not change**.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Internal version \u2014 <b>do not change<\/b>.<\/p>",
    "meta": "Type: String | Default: `\"1.0\"` | Docs: CONFIGURATION.md",
    "defaultVal": "`\"1.0\"`",
    "defaultSnippet": "version: `\"1.0\"`"
  },
  "teleportdelay": {
    "title": "teleportDelay",
    "desc": "Wait time before teleport occurs. Accepts raw seconds (`2`) or duration units (e.g. `2s`, `40t`, `1500ms`). `0` teleports immediately (skips the cancel-on-move window).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Wait time before teleport occurs. Accepts raw seconds (<code style=\\\"color:var(--yellow);\\\"><b>2<\/b><\/code>) or duration units (e.g. <code style=\\\"color:var(--yellow);\\\"><b>2s<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>40t<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>1500ms<\/b><\/code>). <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> teleports immediately (skips the cancel-on-move window).<\/p>",
    "meta": "Type: Integer / Duration | Default: `2` | Docs: CORE_CONFIG.md",
    "defaultVal": "`2`",
    "defaultSnippet": "teleportDelay: `2`"
  },
  "canceldistance": {
    "title": "cancelDistance",
    "desc": "Max distance (blocks) a player can move during the delay before cancellation.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Max distance (blocks) a player can move during the delay before cancellation.<\/p>",
    "meta": "Type: Integer | Default: `2` | Docs: CORE_CONFIG.md",
    "defaultVal": "`2`",
    "defaultSnippet": "cancelDistance: `2`"
  },
  "teleportcooldown": {
    "title": "teleportCooldown",
    "desc": "Wait time between successful RTP uses. Accepts raw seconds (`300`) or duration units (e.g. `5m`, `300s`, `1h`). Bypassed by `rtp.nocooldown`.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Wait time between successful RTP uses. Accepts raw seconds (<code style=\\\"color:var(--yellow);\\\"><b>300<\/b><\/code>) or duration units (e.g. <code style=\\\"color:var(--yellow);\\\"><b>5m<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>300s<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>1h<\/b><\/code>). Bypassed by <code style=\\\"color:var(--yellow);\\\"><b>rtp.nocooldown<\/b><\/code>.<\/p>",
    "meta": "Type: Integer / Duration | Default: `300` | Docs: CORE_CONFIG.md",
    "defaultVal": "`300`",
    "defaultSnippet": "teleportCooldown: `300`"
  },
  "lockafteruses": {
    "title": "lockAfterUses",
    "desc": "Max successful `/rtp` uses within the `lockAfterResetSeconds` window before lockout (BetterRTP `LockAfter` parity). `0` disables. Bypassed by `rtp.nolock`.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Max successful <code style=\\\"color:var(--yellow);\\\"><b>/rtp<\/b><\/code> uses within the <code style=\\\"color:var(--yellow);\\\"><b>lockAfterResetSeconds<\/b><\/code> window before lockout (BetterRTP <code style=\\\"color:var(--yellow);\\\"><b>LockAfter<\/b><\/code> parity). <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> disables. Bypassed by <code style=\\\"color:var(--yellow);\\\"><b>rtp.nolock<\/b><\/code>.<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: CORE_CONFIG.md",
    "defaultVal": "`0`",
    "defaultSnippet": "lockAfterUses: `0`"
  },
  "lockafterresetseconds": {
    "title": "lockAfterResetSeconds",
    "desc": "Length of the rolling usage-cap window for `lockAfterUses`. Accepts raw seconds or duration units (e.g. `24h`, `1d`). `0` means the cap never resets (a hard lifetime cap).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Length of the rolling usage-cap window for <code style=\\\"color:var(--yellow);\\\"><b>lockAfterUses<\/b><\/code>. Accepts raw seconds or duration units (e.g. <code style=\\\"color:var(--yellow);\\\"><b>24h<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>1d<\/b><\/code>). <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> means the cap never resets (a hard lifetime cap).<\/p>",
    "meta": "Type: Integer / Duration | Default: `0` | Docs: CORE_CONFIG.md",
    "defaultVal": "`0`",
    "defaultSnippet": "lockAfterResetSeconds: `0`"
  },
  "setrespawnonteleport": {
    "title": "setRespawnOnTeleport",
    "desc": "When `true`, a successful `/rtp` sets the landed location as the player's persistent spawn anchor (BetterRTP `SetAsRespawn` parity).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">When <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, a successful <code style=\\\"color:var(--yellow);\\\"><b>/rtp<\/b><\/code> sets the landed location as the player's persistent spawn anchor (BetterRTP <code style=\\\"color:var(--yellow);\\\"><b>SetAsRespawn<\/b><\/code> parity).<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: CORE_CONFIG.md",
    "defaultVal": "`false`",
    "defaultSnippet": "setRespawnOnTeleport: `false`"
  },
  "renderer": {
    "title": "renderer",
    "desc": "Ordered preference list of renderer ids. On exception or a missing adapter the framework walks the list and falls back to the next entry. Available ids: `book`, `chat`. If the list is exhausted, the no-token open-page path falls back to the configurable `menuInvalid` message.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Ordered preference list of renderer ids. On exception or a missing adapter the framework walks the list and falls back to the next entry. Available ids: <code style=\\\"color:var(--yellow);\\\"><b>book<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>chat<\/b><\/code>. If the list is exhausted, the no-token open-page path falls back to the configurable <code style=\\\"color:var(--yellow);\\\"><b>menuInvalid<\/b><\/code> message.<\/p>",
    "meta": "Type: List | Default: `[ \"book\" ]` | Docs: CORE_CONFIG.md",
    "defaultVal": "`[ \"book\" ]`",
    "defaultSnippet": "renderer: `[ \"book\" ]`"
  },
  "shape": {
    "title": "shape",
    "desc": "The **`shape`** block defines the horizontal area where players can land and selects candidate coordinates.\n\n### Selection Modes (`mode:`)\n- **`ACCUMULATE`**: *(Recommended)* Even distribution, pre-calculated sectors, 1D Archimedean spiral mapping (ADR-001) or continuous Hilbert key space (ADR-085). Best for general server play.\n- **`NEAREST`**: Finds the closest non-blocked candidate location. Fast, but may cause player clustering.\n- **`REROLL`**: Simple random selection with retries. Even probability but unbounded retry steps.\n- **`NONE`**: Pure candidate walk with zero pre-computation. Ideal for massive radii (> 50,000 blocks).\n\n### Supported Shape Engines\n- **`CIRCLE`**: Uniform radial disk bounded by `radius` with inner donut deadzone `centerRadius`.\n- **`SQUARE`**: Square bounding frame extending `radius` chunks per side.\n- **`POLYGON`**: Arbitrary closed polygon boundary defined by `vertices: [[x1, z1], ...]`.\n- **`ELLIPSE`**: Circle with independent X and Z semi-axes (`radius`, `radius2`) to match rectangular world borders.\n- **`RECTANGLE`**: Explicit side lengths (`width`, `height`) centered on `centerX`/`centerZ`.\n- **`CIRCLE_NORMAL` / `SQUARE_NORMAL`**: Gaussian normal distribution clustering around `mean` with spread `deviation`.\n\n### Distance Units\nAll distances support spatial unit suffixes:\n`256c` (chunks), `4096b` (blocks), `4r` (regions), `5km` (kilometers), or `500nb` (Nether blocks).\n\n> \ud83d\udca1 **Operator Gotcha:** `centerRadius` must be strictly smaller than `radius`. If `centerRadius >= radius`, no pickable band remains!",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">The <b><code style=\\\"color:var(--yellow);\\\"><b>shape<\/b><\/code><\/b> block defines the horizontal area where players can land and selects candidate coordinates.<\/p>\n<h4 style=\"margin:12px 0 6px; color:var(--green); font-size:0.9rem;\">Selection Modes (<code style=\\\"color:var(--yellow);\\\"><b>mode:<\/b><\/code>)<\/h4>\n<ul style=\"margin:6px 0 6px 18px; padding:0; font-size:0.82rem; line-height:1.4;\">\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>ACCUMULATE<\/b><\/code><\/b>: <i>(Recommended)<\/i> Even distribution, pre-calculated sectors, 1D Archimedean spiral mapping (ADR-001) or continuous Hilbert key space (ADR-085). Best for general server play.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>NEAREST<\/b><\/code><\/b>: Finds the closest non-blocked candidate location. Fast, but may cause player clustering.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>REROLL<\/b><\/code><\/b>: Simple random selection with retries. Even probability but unbounded retry steps.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>NONE<\/b><\/code><\/b>: Pure candidate walk with zero pre-computation. Ideal for massive radii (> 50,000 blocks).<\/li>\n<\/ul>\n<h4 style=\"margin:12px 0 6px; color:var(--green); font-size:0.9rem;\">Supported Shape Engines<\/h4>\n<ul style=\"margin:6px 0 6px 18px; padding:0; font-size:0.82rem; line-height:1.4;\">\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>CIRCLE<\/b><\/code><\/b>: Uniform radial disk bounded by <code style=\\\"color:var(--yellow);\\\"><b>radius<\/b><\/code> with inner donut deadzone <code style=\\\"color:var(--yellow);\\\"><b>centerRadius<\/b><\/code>.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>SQUARE<\/b><\/code><\/b>: Square bounding frame extending <code style=\\\"color:var(--yellow);\\\"><b>radius<\/b><\/code> chunks per side.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>POLYGON<\/b><\/code><\/b>: Arbitrary closed polygon boundary defined by <code style=\\\"color:var(--yellow);\\\"><b>vertices: [[x1, z1], ...]<\/b><\/code>.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>ELLIPSE<\/b><\/code><\/b>: Circle with independent X and Z semi-axes (<code style=\\\"color:var(--yellow);\\\"><b>radius<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>radius2<\/b><\/code>) to match rectangular world borders.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>RECTANGLE<\/b><\/code><\/b>: Explicit side lengths (<code style=\\\"color:var(--yellow);\\\"><b>width<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>height<\/b><\/code>) centered on <code style=\\\"color:var(--yellow);\\\"><b>centerX<\/b><\/code>/<code style=\\\"color:var(--yellow);\\\"><b>centerZ<\/b><\/code>.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>CIRCLE_NORMAL<\/b><\/code> / <code style=\\\"color:var(--yellow);\\\"><b>SQUARE_NORMAL<\/b><\/code><\/b>: Gaussian normal distribution clustering around <code style=\\\"color:var(--yellow);\\\"><b>mean<\/b><\/code> with spread <code style=\\\"color:var(--yellow);\\\"><b>deviation<\/b><\/code>.<\/li>\n<\/ul>\n<h4 style=\"margin:12px 0 6px; color:var(--green); font-size:0.9rem;\">Distance Units<\/h4>\n<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">All distances support spatial unit suffixes:<\/p>\n<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\"><code style=\\\"color:var(--yellow);\\\"><b>256c<\/b><\/code> (chunks), <code style=\\\"color:var(--yellow);\\\"><b>4096b<\/b><\/code> (blocks), <code style=\\\"color:var(--yellow);\\\"><b>4r<\/b><\/code> (regions), <code style=\\\"color:var(--yellow);\\\"><b>5km<\/b><\/code> (kilometers), or <code style=\\\"color:var(--yellow);\\\"><b>500nb<\/b><\/code> (Nether blocks).<\/p>\n<div style=\"border-left:3px solid var(--accent); padding:4px 8px; margin:6px 0; background:rgba(137, 180, 250, 0.08); font-size:0.8rem; color:var(--subtext);\">\ud83d\udca1 <b>Operator Gotcha:<\/b> <code style=\\\"color:var(--yellow);\\\"><b>centerRadius<\/b><\/code> must be strictly smaller than <code style=\\\"color:var(--yellow);\\\"><b>radius<\/b><\/code>. If <code style=\\\"color:var(--yellow);\\\"><b>centerRadius >= radius<\/b><\/code>, no pickable band remains!<\/div>",
    "meta": "Type: Section / Block | Engines: CIRCLE, SQUARE, POLYGON, ELLIPSE, RECTANGLE | Docs: REGIONS.md",
    "defaultVal": "CIRCLE (4096b, centerRadius: 64)",
    "defaultSnippet": "shape:\n  name: \"CIRCLE\"\n  mode: \"ACCUMULATE\"\n  radius: 4096b\n  centerRadius: 64\n  centerX: 0\n  centerZ: 0\n  weight: 1.0\n  uniquePlacements: \"auto\"\n  expand: false"
  },
  "vert": {
    "title": "vert",
    "desc": "The **`vert`** block controls how the Y coordinate (height / elevation) is chosen once a horizontal position is selected.\n\n### Vertical Adjustor Engines\n- **`JUMP`**: Scans vertically using fixed `step` block intervals (default: `16`). Fast for finding open surface terrain.\n  - *Nether Caveat:* Because `step` skips in 16-block intervals, it can skip thin 1-2 block ledges. In the Nether, prefer `LINEAR` bottom-up.\n- **`LINEAR`**: Thorough scan of every Y level between `minY` and `maxY`.\n  - `direction: 0`: **Bottom-up** (scans `minY` to `maxY`). Recommended for Nether floor and cave teleports.\n  - `direction: 1`: **Top-down** (scans `maxY` to `minY`). Ideal for surface landings.\n  - `direction: 2`: **Middle-out** (starts in middle and scans outward).\n  - `direction: 3`: **Edges-in**.\n- **`FIXED`**: Places player at an exact mid-air Y level (`y: 64`) with no terrain scan. Designed for skyblock worlds; pair with a platform builder!\n\n### Common Settings\n- `minY` / `maxY`: Safe elevation bounds (e.g. `32` to `255`, or `32` to `120` in the Nether).\n- `requireSkyLight`: When `true`, accepts only locations with direct sky access (above ground only).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">The <b><code style=\\\"color:var(--yellow);\\\"><b>vert<\/b><\/code><\/b> block controls how the Y coordinate (height / elevation) is chosen once a horizontal position is selected.<\/p>\n<h4 style=\"margin:12px 0 6px; color:var(--green); font-size:0.9rem;\">Vertical Adjustor Engines<\/h4>\n<ul style=\"margin:6px 0 6px 18px; padding:0; font-size:0.82rem; line-height:1.4;\">\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>JUMP<\/b><\/code><\/b>: Scans vertically using fixed <code style=\\\"color:var(--yellow);\\\"><b>step<\/b><\/code> block intervals (default: <code style=\\\"color:var(--yellow);\\\"><b>16<\/b><\/code>). Fast for finding open surface terrain.<\/li>\n<li style=\"margin-bottom:4px;\"><i>Nether Caveat:<\/i> Because <code style=\\\"color:var(--yellow);\\\"><b>step<\/b><\/code> skips in 16-block intervals, it can skip thin 1-2 block ledges. In the Nether, prefer <code style=\\\"color:var(--yellow);\\\"><b>LINEAR<\/b><\/code> bottom-up.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>LINEAR<\/b><\/code><\/b>: Thorough scan of every Y level between <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code> and <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>.<\/li>\n<li style=\"margin-bottom:4px;\"><code style=\\\"color:var(--yellow);\\\"><b>direction: 0<\/b><\/code>: <b>Bottom-up<\/b> (scans <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>). Recommended for Nether floor and cave teleports.<\/li>\n<li style=\"margin-bottom:4px;\"><code style=\\\"color:var(--yellow);\\\"><b>direction: 1<\/b><\/code>: <b>Top-down<\/b> (scans <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code>). Ideal for surface landings.<\/li>\n<li style=\"margin-bottom:4px;\"><code style=\\\"color:var(--yellow);\\\"><b>direction: 2<\/b><\/code>: <b>Middle-out<\/b> (starts in middle and scans outward).<\/li>\n<li style=\"margin-bottom:4px;\"><code style=\\\"color:var(--yellow);\\\"><b>direction: 3<\/b><\/code>: <b>Edges-in<\/b>.<\/li>\n<li style=\"margin-bottom:4px;\"><b><code style=\\\"color:var(--yellow);\\\"><b>FIXED<\/b><\/code><\/b>: Places player at an exact mid-air Y level (<code style=\\\"color:var(--yellow);\\\"><b>y: 64<\/b><\/code>) with no terrain scan. Designed for skyblock worlds; pair with a platform builder!<\/li>\n<\/ul>\n<h4 style=\"margin:12px 0 6px; color:var(--green); font-size:0.9rem;\">Common Settings<\/h4>\n<ul style=\"margin:6px 0 6px 18px; padding:0; font-size:0.82rem; line-height:1.4;\">\n<li style=\"margin-bottom:4px;\"><code style=\\\"color:var(--yellow);\\\"><b>minY<\/b><\/code> / <code style=\\\"color:var(--yellow);\\\"><b>maxY<\/b><\/code>: Safe elevation bounds (e.g. <code style=\\\"color:var(--yellow);\\\"><b>32<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>255<\/b><\/code>, or <code style=\\\"color:var(--yellow);\\\"><b>32<\/b><\/code> to <code style=\\\"color:var(--yellow);\\\"><b>120<\/b><\/code> in the Nether).<\/li>\n<li style=\"margin-bottom:4px;\"><code style=\\\"color:var(--yellow);\\\"><b>requireSkyLight<\/b><\/code>: When <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, accepts only locations with direct sky access (above ground only).<\/li>\n<\/ul>",
    "meta": "Type: Section / Block | Engines: JUMP, LINEAR, FIXED | Docs: REGIONS.md",
    "defaultVal": "LINEAR (minY: 32, maxY: 255)",
    "defaultSnippet": "vert:\n  name: \"LINEAR\"\n  minY: 32\n  maxY: 255\n  direction: 2\n  requireSkyLight: true"
  },
