  "minlevel": {
    "title": "min_level",
    "desc": "Plugin-scoped minimum log level. The effective filter is the finer of this and the server logger's own level; `ALL` keeps behavior identical to the server logger. Options: `SEVERE`, `WARNING`, `INFO`, `CONFIG`, `FINE`, `FINER`, `FINEST`, `ALL`, `OFF`.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Plugin-scoped minimum log level. The effective filter is the finer of this and the server logger's own level; <code style=\\\"color:var(--yellow);\\\"><b>ALL<\/b><\/code> keeps behavior identical to the server logger. Options: <code style=\\\"color:var(--yellow);\\\"><b>SEVERE<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>WARNING<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>INFO<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>CONFIG<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>FINE<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>FINER<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>FINEST<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>ALL<\/b><\/code>, <code style=\\\"color:var(--yellow);\\\"><b>OFF<\/b><\/code>.<\/p>",
    "meta": "Type: Enum | Default: `INFO` | Docs: LOGGING.md",
    "defaultVal": "`INFO`",
    "defaultSnippet": "min_level: `INFO`"
  },
  "foliaincluderegions": {
    "title": "foliaIncludeRegions",
    "desc": "Populate the snapshot's per-region detail on Folia. No effect on Paper / Bukkit / Fabric / NeoForge.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Populate the snapshot's per-region detail on Folia. No effect on Paper / Bukkit / Fabric / NeoForge.<\/p>",
    "meta": "Type: Boolean | Default: `true` | Docs: METRICS.md",
    "defaultVal": "`true`",
    "defaultSnippet": "foliaIncludeRegions: `true`"
  },
  "foliaaggregationtps": {
    "title": "foliaAggregationTps",
    "desc": "Strategy used to fold per-region samples into the scalar `tps{1,5,15}m` fields on Folia.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Strategy used to fold per-region samples into the scalar <code style=\\\"color:var(--yellow);\\\"><b>tps{1,5,15}m<\/b><\/code> fields on Folia.<\/p>",
    "meta": "Type: Enum | Default: `mean` | Docs: METRICS.md",
    "defaultVal": "`mean`",
    "defaultSnippet": "foliaAggregationTps: `mean`"
  },
  "foliaaggregationmspt": {
    "title": "foliaAggregationMspt",
    "desc": "Strategy used to fold per-region samples into the scalar `mspt` field on Folia.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Strategy used to fold per-region samples into the scalar <code style=\\\"color:var(--yellow);\\\"><b>mspt<\/b><\/code> field on Folia.<\/p>",
    "meta": "Type: Enum | Default: `max` | Docs: METRICS.md",
    "defaultVal": "`max`",
    "defaultSnippet": "foliaAggregationMspt: `max`"
  },
  "foliaaggregationtickbudget": {
    "title": "foliaAggregationTickBudget",
    "desc": "Strategy used to fold per-region samples into the scalar `tickBudgetUtilisation` field on Folia.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Strategy used to fold per-region samples into the scalar <code style=\\\"color:var(--yellow);\\\"><b>tickBudgetUtilisation<\/b><\/code> field on Folia.<\/p>",
    "meta": "Type: Enum | Default: `max` | Docs: METRICS.md",
    "defaultVal": "`max`",
    "defaultSnippet": "foliaAggregationTickBudget: `max`"
  },
  "mintps": {
    "title": "minTPS",
    "desc": "Minimum server TPS required to queue new locations. Range: 0.0\u201320.0.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Minimum server TPS required to queue new locations. Range: 0.0\u201320.0.<\/p>",
    "meta": "Type: Double | Default: `19.0` | Docs: PERFORMANCE.md",
    "defaultVal": "`19.0`",
    "defaultSnippet": "minTPS: `19.0`"
  },
  "maxheappercent": {
    "title": "maxHeapPercent",
    "desc": "Pause cache filling when JVM memory use passes this percentage. `0` or `100` disables. Range: 0.0\u2013100.0.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Pause cache filling when JVM memory use passes this percentage. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> or <code style=\\\"color:var(--yellow);\\\"><b>100<\/b><\/code> disables. Range: 0.0\u2013100.0.<\/p>",
    "meta": "Type: Double | Default: `85.0` | Docs: PERFORMANCE.md",
    "defaultVal": "`85.0`",
    "defaultSnippet": "maxHeapPercent: `85.0`"
  },
  "maxattempts": {
    "title": "maxAttempts",
    "desc": "Maximum location search attempts before giving up.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Maximum location search attempts before giving up.<\/p>",
    "meta": "Type: Integer | Default: `32` | Docs: PERFORMANCE.md",
    "defaultVal": "`32`",
    "defaultSnippet": "maxAttempts: `32`"
  },
  "period": {
    "title": "period",
    "desc": "Ticks between background cache cycles (20 ticks = 1 second).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Ticks between background cache cycles (20 ticks = 1 second).<\/p>",
    "meta": "Type: Integer | Default: `20` | Docs: PERFORMANCE.md",
    "defaultVal": "`20`",
    "defaultSnippet": "period: `20`"
  },
  "syncallottedtime": {
    "title": "syncAllottedTime",
    "desc": "Max milliseconds per tick spent on synchronous RTP tasks.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Max milliseconds per tick spent on synchronous RTP tasks.<\/p>",
    "meta": "Type: Integer | Default: `50` | Docs: PERFORMANCE.md",
    "defaultVal": "`50`",
    "defaultSnippet": "syncAllottedTime: `50`"
  },
  "asyncallottedtime": {
    "title": "asyncAllottedTime",
    "desc": "Max milliseconds per tick spent on asynchronous RTP tasks.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Max milliseconds per tick spent on asynchronous RTP tasks.<\/p>",
    "meta": "Type: Integer | Default: `50` | Docs: PERFORMANCE.md",
    "defaultVal": "`50`",
    "defaultSnippet": "asyncAllottedTime: `50`"
  },
  "viewdistanceselect": {
    "title": "viewDistanceSelect",
    "desc": "Chunk radius to pre-load around candidate locations during selection. `0` = just the candidate chunk.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Chunk radius to pre-load around candidate locations during selection. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> = just the candidate chunk.<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: PERFORMANCE.md",
    "defaultVal": "`0`",
    "defaultSnippet": "viewDistanceSelect: `0`"
  },
  "viewdistanceteleport": {
    "title": "viewDistanceTeleport",
    "desc": "Chunk radius to pre-load around the destination before teleport. `0` = just the destination chunk.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Chunk radius to pre-load around the destination before teleport. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> = just the destination chunk.<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: PERFORMANCE.md",
    "defaultVal": "`0`",
    "defaultSnippet": "viewDistanceTeleport: `0`"
  },
  "viewdistancerestoreinterval": {
    "title": "viewDistanceRestoreInterval",
    "desc": "Ticks to ease view distance back to normal after arrival. Set to `0` (off) to prevent client-side flashing.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Ticks to ease view distance back to normal after arrival. Set to <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> (off) to prevent client-side flashing.<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: PERFORMANCE.md",
    "defaultVal": "`0`",
    "defaultSnippet": "viewDistanceRestoreInterval: `0`"
  },
  "syncloading": {
    "title": "syncLoading",
    "desc": "Use synchronous chunk loading for location selection. **NOT RECOMMENDED**.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Use synchronous chunk loading for location selection. <b>NOT RECOMMENDED<\/b>.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: PERFORMANCE.md",
    "defaultVal": "`false`",
    "defaultSnippet": "syncLoading: `false`"
  },
  "postteleportqueueing": {
    "title": "postTeleportQueueing",
    "desc": "Immediately try to refill the cache after a teleport occurs.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Immediately try to refill the cache after a teleport occurs.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: PERFORMANCE.md",
    "defaultVal": "`false`",
    "defaultSnippet": "postTeleportQueueing: `false`"
  },
  "checkonchunkloads": {
    "title": "checkOnChunkLoads",
    "desc": "Learn biomes from chunks already loaded without doing extra work.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Learn biomes from chunks already loaded without doing extra work.<\/p>",
    "meta": "Type: Boolean | Default: `true` | Docs: PERFORMANCE.md",
    "defaultVal": "`true`",
    "defaultSnippet": "checkOnChunkLoads: `true`"
  },
  "backlogrefillthreshold": {
    "title": "backlogRefillThreshold",
    "desc": "Refill the L3 backlog buffer when it drops to this fraction (e.g. `0.5` = 50%). Range: 0.0\u20131.0.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Refill the L3 backlog buffer when it drops to this fraction (e.g. <code style=\\\"color:var(--yellow);\\\"><b>0.5<\/b><\/code> = 50%). Range: 0.0\u20131.0.<\/p>",
    "meta": "Type: Double | Default: `0.5` | Docs: PERFORMANCE.md",
    "defaultVal": "`0.5`",
    "defaultSnippet": "backlogRefillThreshold: `0.5`"
  },
  "pregeneratedpreference": {
    "title": "pregeneratedPreference",
    "desc": "Bias toward pregenerated chunks over generating new terrain. Range: 0.0\u20131.0 (0 = no preference, 1 = avoid ungenerated).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Bias toward pregenerated chunks over generating new terrain. Range: 0.0\u20131.0 (0 = no preference, 1 = avoid ungenerated).<\/p>",
    "meta": "Type: Double | Default: `0.0` | Docs: PERFORMANCE.md",
    "defaultVal": "`0.0`",
    "defaultSnippet": "pregeneratedPreference: `0.0`"
  },
  "logincacheenabled": {
    "title": "loginCacheEnabled",
    "desc": "Maintain a dedicated reserve of safe spots for players joining the server (`rtp.onevent.join`/`firstjoin`).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Maintain a dedicated reserve of safe spots for players joining the server (<code style=\\\"color:var(--yellow);\\\"><b>rtp.onevent.join<\/b><\/code>/<code style=\\\"color:var(--yellow);\\\"><b>firstjoin<\/b><\/code>).<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: PERFORMANCE.md",
    "defaultVal": "`false`",
    "defaultSnippet": "loginCacheEnabled: `false`"
  },
  "logincachecap": {
    "title": "loginCacheCap",
    "desc": "Max size of the login reserve cache. `0` = auto (server max players).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Max size of the login reserve cache. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> = auto (server max players).<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: PERFORMANCE.md",
    "defaultVal": "`0`",
    "defaultSnippet": "loginCacheCap: `0`"
  },
  "biomerecall": {
    "title": "biomeRecall",
    "desc": "Reuse previously found biome locations.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Reuse previously found biome locations.<\/p>",
    "meta": "Type: Boolean | Default: `true` | Docs: PERFORMANCE.md",
    "defaultVal": "`true`",
    "defaultSnippet": "biomeRecall: `true`"
  },
  "biomerecallforced": {
    "title": "biomeRecallForced",
    "desc": "Only use biomes that have already been discovered and cached.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Only use biomes that have already been discovered and cached.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: PERFORMANCE.md",
    "defaultVal": "`false`",
    "defaultSnippet": "biomeRecallForced: `false`"
  },
  "oneventparsing": {
    "title": "onEventParsing",
    "desc": "Parse permissions on every event. Incompatible with `*.*` permissions.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Parse permissions on every event. Incompatible with <code style=\\\"color:var(--yellow);\\\"><b><i>.<\/i><\/b><\/code> permissions.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: PERFORMANCE.md",
    "defaultVal": "`false`",
    "defaultSnippet": "onEventParsing: `false`"
  },
  "effectparsing": {
    "title": "effectParsing",
    "desc": "Parse effect permissions on startup.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Parse effect permissions on startup.<\/p>",
    "meta": "Type: Boolean | Default: `true` | Docs: PERFORMANCE.md",
    "defaultVal": "`true`",
    "defaultSnippet": "effectParsing: `true`"
  },
  "slowpipelinethresholdms": {
    "title": "slowPipelineThresholdMs",
    "desc": "Log a warning when a teleport takes longer than this threshold in ms. `0` or negative disables.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Log a warning when a teleport takes longer than this threshold in ms. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> or negative disables.<\/p>",
    "meta": "Type: Integer | Default: `5000` | Docs: PERFORMANCE.md",
    "defaultVal": "`5000`",
    "defaultSnippet": "slowPipelineThresholdMs: `5000`"
  },
  "queuegrowthwarnthreshold": {
    "title": "queueGrowthWarnThreshold",
    "desc": "Log a warning when the player wait queue depth exceeds this number. `0` or negative disables.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Log a warning when the player wait queue depth exceeds this number. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> or negative disables.<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: PERFORMANCE.md",
    "defaultVal": "`0`",
    "defaultSnippet": "queueGrowthWarnThreshold: `0`"
  },
  "visitorenabled": {
    "title": "visitorEnabled",
    "desc": "Enable background observation mode.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Enable background observation mode.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: PERFORMANCE.md",
    "defaultVal": "`false`",
    "defaultSnippet": "visitorEnabled: `false`"
  },
  "prefabbakretention": {
    "title": "prefab.bakRetention",
    "desc": "Number of `.bak` backup files to retain per file when applying `/rtp admin prefab` presets.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Number of <code style=\\\"color:var(--yellow);\\\"><b>.bak<\/b><\/code> backup files to retain per file when applying <code style=\\\"color:var(--yellow);\\\"><b>/rtp admin prefab<\/b><\/code> presets.<\/p>",
    "meta": "Type: Integer | Default: `3` | Docs: PERFORMANCE.md",
    "defaultVal": "`3`",
    "defaultSnippet": "prefab.bakRetention: `3`"
  },
  "displayname": {
    "title": "displayName",
    "desc": "Optional cosmetic display name shown in menus and messages; does not change the region's identity or the permission node.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Optional cosmetic display name shown in menus and messages; does not change the region's identity or the permission node.<\/p>",
    "meta": "Type: String | Default: (region name) | Docs: REGIONS.md",
    "defaultVal": "(region name)",
    "defaultSnippet": "displayName: (region name)"
  },
  "biomewhitelist": {
    "title": "biomeWhitelist",
    "desc": "If `true`, the `biomes` list is a **whitelist**. If `false`, it is a **blacklist**.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">If <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, the <code style=\\\"color:var(--yellow);\\\"><b>biomes<\/b><\/code> list is a <b>whitelist<\/b>. If <code style=\\\"color:var(--yellow);\\\"><b>false<\/b><\/code>, it is a <b>blacklist<\/b>.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: SAFETY.md",
    "defaultVal": "`false`",
    "defaultSnippet": "biomeWhitelist: `false`"
  },
  "biomes": {
    "title": "biomes",
    "desc": "Biomes to skip or allow. Default blacklist excludes oceans, rivers, and void biomes.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Biomes to skip or allow. Default blacklist excludes oceans, rivers, and void biomes.<\/p>",
    "meta": "Type: List | Default: *(Ocean, etc.)* | Docs: SAFETY.md",
    "defaultVal": "*(Ocean, etc.)*",
    "defaultSnippet": "biomes: *(Ocean, etc.)*"
  },
  "invulnerabilitytime": {
    "title": "invulnerabilityTime",
    "desc": "Seconds of invulnerability granted after teleporting. Prevents fall, fire, or drowning damage on arrival.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Seconds of invulnerability granted after teleporting. Prevents fall, fire, or drowning damage on arrival.<\/p>",
    "meta": "Type: Integer | Default: `5` | Docs: SAFETY.md",
    "defaultVal": "`5`",
    "defaultSnippet": "invulnerabilityTime: `5`"
  },
  "safetyradius": {
    "title": "safetyRadius",
    "desc": "Block radius around the landing point to check for hazards. `0` = check only the landing block.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Block radius around the landing point to check for hazards. <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> = check only the landing block.<\/p>",
    "meta": "Type: Integer | Default: `0` | Docs: SAFETY.md",
    "defaultVal": "`0`",
    "defaultSnippet": "safetyRadius: `0`"
  },
  "stalechunkretrylimit": {
    "title": "staleChunkRetryLimit",
    "desc": "Bounded retry budget for the stale-chunk guard. Prevents race conditions where a chunk unloads before evaluation.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Bounded retry budget for the stale-chunk guard. Prevents race conditions where a chunk unloads before evaluation.<\/p>",
    "meta": "Type: Integer | Default: `2` | Docs: SAFETY.md",
    "defaultVal": "`2`",
    "defaultSnippet": "staleChunkRetryLimit: `2`"
  },
  "anvilprefilterenabled": {
    "title": "anvilPrefilterEnabled",
    "desc": "Off-thread region prefilter: screens candidate destinations by reading region files (`.mca` Anvil or `.linear` Linear format) from disk, dropping known-unsafe ones before they cost a chunk load. A chunk it cannot read (e.g. not yet generated) is not rejected - it passes through to the normal live-load safety check.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Off-thread region prefilter: screens candidate destinations by reading region files (<code style=\\\"color:var(--yellow);\\\"><b>.mca<\/b><\/code> Anvil or <code style=\\\"color:var(--yellow);\\\"><b>.linear<\/b><\/code> Linear format) from disk, dropping known-unsafe ones before they cost a chunk load. A chunk it cannot read (e.g. not yet generated) is not rejected - it passes through to the normal live-load safety check.<\/p>",
    "meta": "Type: Boolean | Default: `true` | Docs: SAFETY.md",
    "defaultVal": "`true`",
    "defaultSnippet": "anvilPrefilterEnabled: `true`"
  },
  "platformradius": {
    "title": "platformRadius",
    "desc": "Radius of the emergency platform. Set to `-1` to disable (recommended).",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Radius of the emergency platform. Set to <code style=\\\"color:var(--yellow);\\\"><b>-1<\/b><\/code> to disable (recommended).<\/p>",
    "meta": "Type: Integer | Default: `-1` | Docs: SAFETY.md",
    "defaultVal": "`-1`",
    "defaultSnippet": "platformRadius: `-1`"
  },
  "platformdepth": {
    "title": "platformDepth",
    "desc": "Depth (downward) of the platform.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Depth (downward) of the platform.<\/p>",
    "meta": "Type: Integer | Default: `1` | Docs: SAFETY.md",
    "defaultVal": "`1`",
    "defaultSnippet": "platformDepth: `1`"
  },
  "platformairheight": {
    "title": "platformAirHeight",
    "desc": "Height of air to ensure above the platform.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Height of air to ensure above the platform.<\/p>",
    "meta": "Type: Integer | Default: `2` | Docs: SAFETY.md",
    "defaultVal": "`2`",
    "defaultSnippet": "platformAirHeight: `2`"
  },
  "platformmaterial": {
    "title": "platformMaterial",
    "desc": "Block type used if no solid block exists.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Block type used if no solid block exists.<\/p>",
    "meta": "Type: String | Default: `GLASS` | Docs: SAFETY.md",
    "defaultVal": "`GLASS`",
    "defaultSnippet": "platformMaterial: `GLASS`"
  },
  "platformrestoreseconds": {
    "title": "platformRestoreSeconds",
    "desc": "Optional timeout after which a built platform's footprint is restored to its original blocks. `-1` disables restoration (permanent platform). `0` restores as soon as the footprint chunk is loaded again; a positive value restores after that many seconds. The countdown only advances while the footprint chunk is loaded (it pauses while the area is unloaded), and pending restores survive a server restart.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">Optional timeout after which a built platform's footprint is restored to its original blocks. <code style=\\\"color:var(--yellow);\\\"><b>-1<\/b><\/code> disables restoration (permanent platform). <code style=\\\"color:var(--yellow);\\\"><b>0<\/b><\/code> restores as soon as the footprint chunk is loaded again; a positive value restores after that many seconds. The countdown only advances while the footprint chunk is loaded (it pauses while the area is unloaded), and pending restores survive a server restart.<\/p>",
    "meta": "Type: Integer | Default: `-1` | Docs: SAFETY.md",
    "defaultVal": "`-1`",
    "defaultSnippet": "platformRestoreSeconds: `-1`"
  },
  "pvpcheckenabled": {
    "title": "pvpCheckEnabled",
    "desc": "When `true`, checks if a player is in combat before teleporting.",
    "html": "<p style=\"margin:6px 0; font-size:0.82rem; line-height:1.4;\">When <code style=\\\"color:var(--yellow);\\\"><b>true<\/b><\/code>, checks if a player is in combat before teleporting.<\/p>",
    "meta": "Type: Boolean | Default: `false` | Docs: SAFETY.md",
    "defaultVal": "`false`",
    "defaultSnippet": "pvpCheckEnabled: `false`"
  },
  "pvpcombattagseconds": {
